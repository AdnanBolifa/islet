<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct distribution (notarized, not App Store): no sandbox, so Islet can read
	     sensors, watch notifications and clean any folder. Apple Events drive Music/Spotify. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
